{
    "compilerOptions": {
      "module": "ESNext",
      "target": "ESNext",
      "moduleResolution": "node",
      "esModuleInterop": true,
      "skipLibCheck": true,
      "strict": true,
      "allowJs": true,
      "resolveJsonModule": true
    },
    "include": ["src/**/*", "Tests/**/*"]
  }
  